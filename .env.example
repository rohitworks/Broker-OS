# Public white-label settings. Replace for each deployment; never hardcode them in UI code.
NEXT_PUBLIC_APP_NAME="Broker OS"
NEXT_PUBLIC_BRAND_PRIMARY="#14532d"
NEXT_PUBLIC_BRAND_ACCENT="#f59e0b"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_BUSINESS_LOCALE="en-IN"
NEXT_PUBLIC_BUSINESS_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_BUSINESS_CURRENCY="INR"
NEXT_PUBLIC_SUPPORT_PHONE="+910000000000"
NEXT_PUBLIC_DEFAULT_LOCALITY="Pilot Market"

# Supabase. The service role key is server-only and must never use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Cloudflare R2 private bucket. These values are server-only.
R2_ACCOUNT_ID="replace-with-account-id"
R2_ACCESS_KEY_ID="replace-with-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-secret-access-key"
R2_BUCKET_NAME="broker-os-private"

# WhatsApp Cloud API (server-only)
WHATSAPP_VERIFY_TOKEN="replace-with-random-verify-token"
WHATSAPP_APP_SECRET="replace-with-app-secret"
WHATSAPP_BUSINESS_ID="replace-with-business-uuid"
